# FluxPay Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# Never commit raw secrets or production credentials to source control.

# Application Profile (local, docker, test, prod)
SPRING_PROFILES_ACTIVE=local

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/payflow
DATABASE_USERNAME=payflow_user
DATABASE_PASSWORD=payflow_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Security & Authentication
# High-entropy 256-bit secret key for HMAC-SHA256 JWT signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Provider A: Stripe Sandbox Credentials
STRIPE_API_KEY=sk_test_payflow_stripe_dummy
STRIPE_WEBHOOK_SECRET=whsec_test_stripe_secret_12345
STRIPE_BASE_URL=https://api.stripe.com

# Provider B: Adyen Sandbox Credentials
ADYEN_API_KEY=test_adyen_key_dummy
ADYEN_MERCHANT_ACCOUNT=PayflowMerchant
ADYEN_WEBHOOK_SECRET=44782ECE0522E02C8D683BD34296A4E6FE5DF46E
ADYEN_BASE_URL=https://checkout-test.adyen.com

# Provider C: Razorpay Sandbox Credentials
RAZORPAY_KEY_ID=rzp_test_payflow_dummy
RAZORPAY_KEY_SECRET=rzp_secret_dummy
RAZORPAY_WEBHOOK_SECRET=whsec_test_razorpay_secret_12345
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Provider D: PayU Sandbox Credentials
PAYU_KEY=test_payu_merchant_key
PAYU_SALT=test_payu_merchant_salt
PAYU_BASE_URL=https://test.payu.in
PAYU_SERVICE_URL=https://test.payu.in/merchant/postservice.php?form=2

# Provider E: Cashfree Sandbox Credentials
CASHFREE_APP_ID=TEST_CF_APP_ID_DUMMY
CASHFREE_SECRET_KEY=cf_secret_key_dummy
CASHFREE_API_VERSION=2023-08-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg

# Frontend Configuration
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

